<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root {
    --bg: #f5f6f8; --paper: #ffffff; --ink: #18233b; --muted: #5b6578; --line: #dde1e8;
    --accent: #18233b; --bad: #c21f3a; --warn: #b86a0b; --ok: #2e7d5b; --quote: #eef1f5;
    --link: #2f54eb; --mark: #fff1a8;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #12161d; --paper: #1a1f28; --ink: #e4e8ef; --muted: #9aa3b2; --line: #2c3340;
      --accent: #e4e8ef; --bad: #f0687d; --warn: #e0a148; --ok: #5cc195; --quote: #222935;
      --link: #8aa2ff; --mark: #5a4d12;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
         font: 16px/1.6 "Segoe UI", system-ui, -apple-system, Roboto, sans-serif; }
  main { max-width: 1080px; margin: 0 auto; padding: 32px 16px 80px; }
  .paper { background: var(--paper); border: 1px solid var(--line); border-radius: 4px; padding: 8px 32px 32px; }
  .badge { display: inline-block; margin: 24px 0 0; padding: 6px 14px; border-radius: 999px; font-weight: 600;
           font-size: 14px; color: var(--paper); background: var(--ok); }
  .badge.not_ready { background: var(--bad); } .badge.ready_after_fixes { background: var(--warn); }
  h1 { font-size: 28px; line-height: 1.25; margin: 16px 0 8px; }
  h2 { font-size: 22px; margin: 40px 0 12px; padding-top: 12px; border-top: 1px solid var(--line); }
  h3 { font-size: 18px; margin: 28px 0 8px; }
  h4 { font-size: 16px; margin: 28px 0 6px; color: var(--accent); }
  p, li { max-width: 80ch; }
  blockquote { margin: 8px 0 12px; padding: 10px 16px; background: var(--quote); border-left: 4px solid var(--accent);
               border-radius: 0 8px 8px 0; }
  blockquote p { margin: 4px 0; }
  code { font-family: Consolas, "SF Mono", monospace; font-size: 0.9em; background: var(--quote); padding: 1px 5px;
         border-radius: 4px; overflow-wrap: anywhere; }
  table { border-collapse: collapse; margin: 12px 0 20px; font-size: 14px; display: block; overflow-x: auto; }
  th, td { border: 1px solid var(--line); padding: 6px 10px; vertical-align: top; }
  th { background: var(--quote); text-align: left; }
  td:has(> strong:only-child) { white-space: nowrap; }
  ol > li, ul > li { margin: 4px 0; }
  /* R-07, F-057, Q-08 jump to the place where they are described */
  a.ref { color: var(--link); font-weight: 500; text-decoration: underline dotted; text-underline-offset: 3px; }
  a.ref:hover { text-decoration-style: solid; }
  [id] { scroll-margin-top: 16px; }
  :target { background: var(--mark); border-radius: 4px; box-shadow: 0 0 0 4px var(--mark); }
  ol > li > ul { margin-top: 4px; }
  @media (max-width: 640px) { .paper { padding: 4px 16px 24px; } h1 { font-size: 22px; } }
  @media print { body { background: #fff; } .paper { border: 0; padding: 0; } }
</style>
</head>
<body>
<main>
  <div class="paper">
    <span class="badge {{ decision }}">Revizorro · ревью требований</span>
    {{ body | safe }}
  </div>
</main>
</body>
</html>
