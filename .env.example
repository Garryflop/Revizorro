# Скопируйте этот файл в .env и укажите ключ хотя бы одного провайдера.
# Файл .env в git не попадает (см. .gitignore).

# --- Ключи провайдеров ---
# Google Gemini, бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI (платный): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Модели ---
# Формат: <провайдер>:<модель>. Провайдеры: google, openai, ollama.
# Если не заданы, Revizorro выберет модели сам: при ключе OpenAI — gpt-6-luna + gpt-6.1-terra, иначе Gemini.
# MODEL_DEFAULT — массовые шаги (проверка каждого требования, тест-дизайн).
# MODEL_STRONG  — шаги, где важна глубина: нарезка, проверка набора, критик, вопросы, итог.
# Бесплатно на Gemini:
# MODEL_DEFAULT=google:gemini-3.5-flash
# MODEL_STRONG=google:gemini-3.5-flash
# OpenAI, баланс цены и качества, около $0.25 за прогон (берётся по умолчанию при ключе OpenAI):
# MODEL_DEFAULT=openai:gpt-6-luna
# MODEL_STRONG=openai:gpt-6.1-terra
# OpenAI, дёшево, около $0.06 за прогон (критичность находок оценивается хуже):
# MODEL_DEFAULT=openai:gpt-6-luna
# MODEL_STRONG=openai:gpt-6-luna
# OpenAI, бесплатные суточные токены (если в организации включён обмен данными с OpenAI):
# роли разведены по двум группам лимита; «сильные» шаги тратят около 140 тыс. токенов за прогон.
# MODEL_DEFAULT=openai:gpt-5.4-mini
# MODEL_STRONG=openai:gpt-5.4
# OpenAI, финальное качество, около $1 за прогон:
# MODEL_DEFAULT=openai:gpt-6.1-terra
# MODEL_STRONG=openai:gpt-6.1-sol

# Запасные модели того же провайдера, если у основной кончилась квота или она перегружена.
# Для Gemini цепочка бесплатных моделей включена по умолчанию.
# MODEL_FALLBACKS=google:gemini-3.8-flash,google:gemini-3.5-flash-lite

# --- Локальная модель (документы не покидают машину) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# MODEL_DEFAULT=ollama:qwen3:14b
# MODEL_STRONG=ollama:qwen3:14b

# --- Тонкая настройка (необязательно) ---
# Сколько запросов к модели идут одновременно (по умолчанию 6, для Gemini 2).
# REVIZORRO_CONCURRENCY=6
# Сколько требований проверяется за один запрос (по умолчанию 6, для Gemini 15).
# REVIZORRO_BATCH_SIZE=6
# Глубина рассуждений модели: low | medium | high
# REVIZORRO_THINKING=medium
# Папка кэша ответов модели: повторный прогон бесплатный и даёт тот же отчёт.
# REVIZORRO_CACHE_DIR=.revizorro_cache
# Порт веб-интерфейса (revizorro-api).
# REVIZORRO_PORT=8000
